{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Publish: Your own server",
            "type": "al",
            "request": "launch",
            "environmentType": "OnPrem",
            "server": "http://bcserver",
            "serverInstance": "BC",
            "authentication": "UserPassword",
            "startupObjectId": 22,
            "breakOnError": "All",
            "breakOnRecordWrite": "None",
            "launchBrowser": true,
            "enableSqlInformationDebugger": true,
            "enableLongRunningSqlStatements": true,
            "longRunningSqlStatementsThreshold": 500,
            "numberOfSqlStatements": 10,
            "tenant": "default"
        },
        {
            "name": "Your own server - reqdocsys",
            "request": "launch",
            "type": "al",
            "environmentType": "Sandbox",
            "server": "http://reqdocsys",
            "serverInstance": "BC",
            "authentication": "UserPassword",
            "startupObjectId": 2500,
            "startupObjectType": "Page",
            "breakOnError": true,
            "launchBrowser": true,
            "enableLongRunningSqlStatements": true,
            "enableSqlInformationDebugger": true,
            "tenant": "default",
            "schemaUpdateMode": "ForceSync"
        }
        {
            "name": "Your own server - smpc",
            "request": "launch",
            "type": "al",
            "environmentType": "Sandbox",
            "server": "http://smpc",
            "serverInstance": "BC",
            "authentication": "UserPassword",
            "startupObjectId": 2500,
            "startupObjectType": "Page",
            "breakOnError": true,
            "launchBrowser": true,
            "enableLongRunningSqlStatements": true,
            "enableSqlInformationDebugger": true,
            "tenant": "default",
            "schemaUpdateMode": "ForceSync"
        }
    ]
}